# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
.next/
out/
*.tsbuildinfo

# 缓存
.turbo/
.eslintcache
.cache/
coverage/

# 环境变量（保留 .env.example）
.env
.env.local
.env.*.local
.env.production
!.env.example

# Prisma 本地产物
apps/api/prisma/*.db
apps/api/prisma/migrations/dev/

# 运行期数据（本地部署）
# ⚠️ 必须锚定仓库根目录（前缀 /）。裸写 `data/` 会匹配**任意层级**的 data 目录，
#    会把源码目录 apps/api/prisma/seed/data/ 一起忽略掉 —— 曾经就这么踩过：
#    种子数据文件从未入库，服务器 clone 下来跑 db:seed 直接
#    "Cannot find module './data/org'"。
/data/
/uploads/
/backups/
docker/backups/
docker/volumes/

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# 密钥与证书（严禁入库）
*.pem
*.key
*.p12
*.pfx
secrets/
