# 统一换行符：源码一律 LF，确保 Linux 容器内构建脚本可执行
* text=auto eol=lf

*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.sql      text eol=lf
*.sh       text eol=lf
*.prisma   text eol=lf
*.css      text eol=lf
Dockerfile text eol=lf
Caddyfile  text eol=lf

# Windows 脚本保持 CRLF
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
*.psm1     text eol=crlf

# 二进制：禁止任何转换
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary

# 生成物折叠显示
pnpm-lock.yaml -diff linguist-generated
