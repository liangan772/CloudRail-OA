{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testMatch": ["**/*.e2e-spec.ts"],
  "moduleFileExtensions": ["ts", "js", "json"],
  "moduleNameMapper": {
    "^@oa/shared$": "<rootDir>/../../packages/shared/src/index.ts"
  },
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json", "isolatedModules": true }]
  },
  "testTimeout": 120000
}
