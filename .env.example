# ---------- 运行时 ----------
NODE_ENV=development
TZ=Asia/Shanghai
API_PORT=3001
WEB_PORT=3000

# ---------- 数据库 / 缓存 ----------
DATABASE_URL=postgresql://oa:oa_dev_password@localhost:5432/oa?schema=public
REDIS_URL=redis://localhost:6379

# ---------- 鉴权 ----------
JWT_ACCESS_SECRET=replace-me-with-64-byte-random-string
JWT_REFRESH_SECRET=replace-me-with-another-64-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- 附件存储 ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- 通知渠道（留空则自动降级为仅站内通知） ----------
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
SMS_PROVIDER=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=

# ---------- 其它 ----------
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
DEFAULT_TENANT_CODE=demo
SEED_ON_START=true
WORKER_MODE=all
BACKUP_CRON=0 3 * * *

# 前端
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
