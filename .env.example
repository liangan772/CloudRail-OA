# ---------- 运行时 ----------
NODE_ENV=development
TZ=Asia/Shanghai
API_PORT=3001
WEB_PORT=3000

# ---------- 数据库 / 缓存 ----------
# 开发模式（宿主机直跑 pnpm dev）用这两项
DATABASE_URL=postgresql://oa:oa_dev_password@localhost:5432/oa?schema=public
REDIS_URL=redis://localhost:6379

# ---------- 生产 compose 专用（docker/docker-compose.prod.yml）----------
# compose 起的自有 postgres 用这三项；留空会被 compose 直接拒绝启动（这是有意的，避免弱口令上线）
POSTGRES_USER=oa
POSTGRES_PASSWORD=
POSTGRES_DB=oa
# 只绑本机，交由宝塔 Nginx 或 Caddy 反代对外；想直接暴露再改成 0.0.0.0
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
# 只有启用 tls profile（自带 Caddy 自动 HTTPS）时才需要
OA_DOMAIN=
ACME_EMAIL=

# ---------- 鉴权 ----------
JWT_ACCESS_SECRET=replace-me-with-64-byte-random-string
JWT_REFRESH_SECRET=replace-me-with-another-64-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- 附件存储 ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- 通知渠道（留空则自动降级为仅站内通知） ----------
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
SMS_PROVIDER=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=

# ---------- 其它 ----------
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
DEFAULT_TENANT_CODE=demo
SEED_ON_START=true
WORKER_MODE=all
BACKUP_CRON=0 3 * * *

# 前端
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
