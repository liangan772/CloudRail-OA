# ---------- 运行时 ----------
NODE_ENV=development
TZ=Asia/Shanghai
API_PORT=3001
WEB_PORT=3000

# ---------- 数据库 / 缓存 ----------
# 开发模式（宿主机直跑 pnpm dev）用这两项
DATABASE_URL=postgresql://oa:oa_dev_password@localhost:5432/oa?schema=public
REDIS_URL=redis://localhost:6379

# ---------- 生产 compose 专用（docker/docker-compose.prod.yml）----------
# compose 起的自有 postgres 用这三项；留空会被 compose 直接拒绝启动（这是有意的，避免弱口令上线）
POSTGRES_USER=oa
POSTGRES_PASSWORD=
POSTGRES_DB=oa
# 只绑本机，交由宝塔 Nginx 或 Caddy 反代对外；想直接暴露再改成 0.0.0.0
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
# 运行时内存上限（兜底用，防异常时把宿主机吃干）。空闲时不会占住这么多。
# 必须**大于**镜像内 Node 的 --max-old-space-size，否则 Node 以为自己有更多堆、
# 实际被 cgroup 卡住，反而更容易被 OOM kill。
#   镜像内堆上限：api=512m、web=768m（见 apps/*/Dockerfile 的 NODE_OPTIONS）
#   构建期堆上限（BUILD_NODE_HEAP_MB）默认 1536m，可用 build --build-arg 覆盖
API_MEM_LIMIT=768m
WEB_MEM_LIMIT=1024m
# 只有启用 tls profile（自带 Caddy 自动 HTTPS）时才需要
OA_DOMAIN=
ACME_EMAIL=
# 口令含 @ : / ? # % 这类 URL 保留字符时，用这一项显式给出容器内连接串（覆盖上面的拼装）
# 例：OA_DATABASE_URL=postgresql://oa:p%40ss@postgres:5432/oa?schema=public
OA_DATABASE_URL=

# ---------- 鉴权 ----------
JWT_ACCESS_SECRET=replace-me-with-64-byte-random-string
JWT_REFRESH_SECRET=replace-me-with-another-64-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- 附件存储 ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- 通知渠道（留空则自动降级为仅站内通知） ----------
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
SMS_PROVIDER=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=

# ---------- 其它 ----------
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
DEFAULT_TENANT_CODE=demo
SEED_ON_START=true
WORKER_MODE=all
BACKUP_CRON=0 3 * * *

# 前端
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
